{
  "name": "@stacked/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.2.0",
    "@stacked/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
