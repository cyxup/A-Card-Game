# ── Stacked ────────────────────────────────────────────────────────────────
# Copy to .env and fill in. In production InfraFlow injects DATABASE_URL for
# a linked managed database automatically.

# Postgres connection string. Use the InfraFlow *pooler* URL in production.
DATABASE_URL=postgres://stacked:stacked@localhost:5432/stacked

# Public origin, used for cookies and WebSocket origin checks.
# Comma-separated list is accepted, e.g. http://localhost:5173,http://localhost:8080
# e.g. https://stacked.production.infraflow.app
APP_ORIGIN=http://localhost:5173

# Port the Node service listens on.
PORT=8080
HOST=0.0.0.0

# Node environment: development | production
NODE_ENV=development

# Run pending database migrations on boot (recommended).
MIGRATE_ON_START=true

# Cookie signing secret — at least 32 random chars. Generate one:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to boot in production with a placeholder or <32 chars.
COOKIE_SECRET=change-me-in-production-please-32-chars-min

# Set to true when served over HTTPS (production).
COOKIE_SECURE=false

# Directory containing the built web app (relative to the working directory).
WEB_DIST=apps/web/dist

